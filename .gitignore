# Credenciales Wi-Fi locales: nunca versionar.
/firmware/invernadero/wifi.local.h

# Los binarios contienen las credenciales compiladas.
/firmware/invernadero/build/
*.bin
*.elf
*.map

# Aplicación web, cachés y configuración privada.
/web/node_modules/
/web/.next/
/web/*.tsbuildinfo
/web/.env*
!/web/.env.example
/.vercel/
/web/.vercel/

# HTTPS del dispositivo: URL, token y configuración de confianza locales.
/firmware/invernadero/cloud.local.h
